{
  "name": "@xerios/design-system",
  "version": "0.3.0",
  "description": "Linear-style design system for Svelte 5: theme tokens, global CSS and generic components",
  "keywords": [
    "svelte",
    "svelte5",
    "design-system",
    "components",
    "ui"
  ],
  "license": "MIT",
  "author": "Xerios",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xerios/design-system.git"
  },
  "homepage": "https://github.com/Xerios/design-system#readme",
  "bugs": "https://github.com/Xerios/design-system/issues",
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/fonts.js",
    "./src/fonts.js",
    "**/*.css",
    "**/*.svelte"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fonts.js": "./dist/fonts.js",
    "./css/*": "./dist/css/*",
    "./components/*": {
      "svelte": "./dist/components/*",
      "default": "./dist/components/*"
    },
    "./lib/*": {
      "svelte": "./dist/lib/*",
      "default": "./dist/lib/*"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm --filter kitchensink dev",
    "build": "svelte-package --input src --output dist && publint",
    "build:kitchensink": "pnpm --filter kitchensink build",
    "screenshot": "pnpm --filter kitchensink screenshot",
    "icons": "node scripts/icons.js",
    "release": "node scripts/release.js",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "any-date-parser": "^2.2.4"
  },
  "peerDependencies": {
    "svelte": "^5.59.2"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@sveltejs/package": "^3.0.3",
    "publint": "^0.3.25",
    "svelte": "^5.59.2",
    "typescript": "^6.0.3"
  }
}
