{
  "name": "@local/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Linear-style design system for Svelte 5: theme tokens, global CSS and generic components",
  "type": "module",
  "sideEffects": [
    "./src/fonts.js",
    "./src/css/*.css",
    "**/*.svelte"
  ],
  "svelte": "./src/index.js",
  "exports": {
    ".": {
      "svelte": "./src/index.js",
      "default": "./src/index.js"
    },
    "./fonts.js": "./src/fonts.js",
    "./css/*": "./src/css/*",
    "./components/*": "./src/components/*",
    "./lib/*": "./src/lib/*",
    "./kitchensink/*": "./src/kitchensink/*"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1"
  },
  "peerDependencies": {
    "svelte": "^5.29.0",
    "vite": ">=6"
  }
}
