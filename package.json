{
  "name": "@local/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Linear-style design system for Svelte 5: theme tokens, global CSS and generic components",
  "type": "module",
  "svelte": "./index.js",
  "exports": {
    ".": { "svelte": "./index.js", "default": "./index.js" },
    "./fonts.js": "./fonts.js",
    "./css/*": "./css/*",
    "./components/*": "./components/*",
    "./lib/*": "./lib/*"
  },
  "sideEffects": ["./fonts.js", "./css/*.css", "**/*.svelte"],
  "peerDependencies": {
    "svelte": "^5.29.0",
    "vite": ">=6"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1"
  }
}
