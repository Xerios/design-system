{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "checkJs": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "paths": {
      "@xerios/design-system": ["../src/index.js"],
      "@xerios/design-system/*": ["../src/*"]
    }
  },
  "include": ["src/**/*.js", "src/**/*.svelte"]
}
